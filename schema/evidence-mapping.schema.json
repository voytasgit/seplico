{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seplico Evidence Mapping v0.3",
  "description": "Maps external job or opportunity requirements to application-scoped claims and optional evidence references without defining suitability scores or requirement semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seplico_version",
    "type",
    "application_id",
    "mappings"
  ],
  "properties": {
    "seplico_version": {
      "const": "0.3"
    },
    "type": {
      "const": "evidence_mapping"
    },
    "application_id": {
      "$ref": "#/$defs/applicationId"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "applicationId": {
      "type": "string",
      "pattern": "^seplico_[A-Za-z0-9_-]{22,64}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^clm_[A-Za-z0-9_-]{4,64}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^ev_[A-Za-z0-9_-]{4,64}$"
    },
    "externalIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "value"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_ref",
        "claim_ref"
      ],
      "properties": {
        "requirement_ref": {
          "$ref": "#/$defs/externalIdentifier"
        },
        "claim_ref": {
          "$ref": "#/$defs/claimId"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        }
      }
    }
  }
}
